# Copy this file to .env and fill in / adjust as needed.

### Server ###
PORT=3000
LOG_LEVEL=info                 # error | warn | info | debug

### TMDB ###
TMDB_API_KEY=your_tmdb_v3_api_key_here
TMDB_POSTER_SIZE=w780          # w92,w154,w185,w342,w500,w780,original
TMDB_BACKDROP_SIZE=w1280       # w300,w780,w1280,original
TMDB_LOGO_SIZE=w500            # w45,w92,w154,w185,w300,w500,original

### Metahub (Cinemeta art) fallback ###
METAHUB_POSTER_SIZE=medium     # small | medium | large
METAHUB_BACKGROUND_SIZE=medium
# HEAD-request + minimum content-length check before trusting a metahub image
# for posters/backdrops (not applied to logos - see README).
METAHUB_VERIFY_EXTRA_CHECK=true
METAHUB_MIN_CONTENT_LENGTH_BYTES=5000

### Caching ###
CACHE_TTL_SECONDS=604800           # final resolved art URL, default 7 days
TMDB_PAYLOAD_TTL_SECONDS=604800    # raw TMDB responses, default 7 days
CACHE_BACKEND=memory               # memory | disk  (disk survives container restarts)
CACHE_DIR=/data/cache

### Quality thresholds (hard filters) ###
MIN_POSTER_WIDTH=750
MIN_BACKDROP_WIDTH=1280
MIN_LOGO_WIDTH=0

### Scoring: vote-count floor that steps down until candidates are found ###
VOTE_FLOOR_START=10
VOTE_FLOOR_MIN=4
VOTE_FLOOR_STEP=2
# If a TMDB language bracket (english/original/textless) has fewer than this
# many eligible images, or nothing in it meets even the minimum vote floor,
# Metahub is tried as a real alternative rather than pure last resort.
MIN_BRACKET_SIZE=5

### Networking / resource usage ###
REQUEST_TIMEOUT_MS=8000
MAX_CONCURRENT_UPSTREAM=10      # lower this on weaker hardware

### Optional ###
# If literally nothing can be found anywhere, redirect here instead of 404.
FALLBACK_IMAGE_URL=

### Trending "TOP" badge (posters only) ###
ENABLE_TRENDING_BADGE=false
TRENDING_SOURCE=tmdb              # tmdb | mdblist
TRENDING_TMDB_WINDOW=day          # day | week (only used when TRENDING_SOURCE=tmdb)
TRENDING_REFRESH_INTERVAL_SECONDS=3600
TRENDING_BADGE_COLOR=#FF8A3D

# MDBList - only used when TRENDING_SOURCE=mdblist. *_LIST accepts either a
# full URL (https://mdblist.com/lists/username/slug) or just "username/slug".
# Public lists need no API key. Separate lists for movies and TV since a
# MDBList list is normally one media type.
MDBLIST_API_KEY=
MDBLIST_MOVIE_LIST=
MDBLIST_TV_LIST=
MDBLIST_LIST_ENDPOINT_TEMPLATE=https://mdblist.com/lists/{list}/json

### Bottom status sash (posters only) ###
ENABLE_STATUS_SASH=false
# Shape: thin full-width baseline + a taller, centered, top-rounded "tag"
# holding the label - not a plain full-height bar.
SASH_BASELINE_HEIGHT_PERCENT=2.5
SASH_HEIGHT_PERCENT=9             # the raised "bump" section
SASH_BUMP_WIDTH_PERCENT=56

# 'auto' (default): color is extracted from each poster's own dominant/
# vibrant color. 'status': use the fixed SASH_COLOR_* below instead.
SASH_COLOR_MODE=auto
# In 'auto' mode, a color must score at least this well (roughly saturation x
# how mid-toned x how populated) to be used; below it, the poster is judged
# too dark/desaturated and SASH_COLOR_DARK_FALLBACK is used instead.
SASH_MIN_SATURATION_SCORE=0.15
SASH_COLOR_DARK_FALLBACK=#232326

RECENT_ADDED_WINDOW_DAYS=30       # movies: "Recently Added" window
AIRING_WINDOW_DAYS=14             # tv: how close to an episode counts as "Airing" vs "Returning"

# Only used when SASH_COLOR_MODE=status.
SASH_COLOR_AIRING=#2563EB
SASH_COLOR_RETURNING=#16A34A
SASH_COLOR_ENDED=#6B5B95
SASH_COLOR_CANCELED=#DC2626
SASH_COLOR_RECENTLY_ADDED=#DC2626

# Composited (badged) posters are cached separately from plain resolved URLs,
# and for less time, since trending/status data changes over time.
BADGE_IMAGE_CACHE_TTL_SECONDS=21600
